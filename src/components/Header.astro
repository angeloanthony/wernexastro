---
// src/components/Header.astro
import { WERNEX, NAV_LINKS } from '../data/business';
interface Props { active?: string; }
const { active = '' } = Astro.props;
const phoneSvg = `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16"><path d="M3.654 1.328a.678.678 0 0 0-1.015-.063L1.605 2.3c-.483.484-.661 1.169-.45 1.77a17.6 17.6 0 0 0 4.168 6.608 17.6 17.6 0 0 0 6.608 4.168c.601.211 1.286.033 1.77-.45l1.034-1.034a.678.678 0 0 0-.063-1.015l-2.307-1.794a.68.68 0 0 0-.58-.122l-2.19.547a1.75 1.75 0 0 1-1.657-.459L5.482 8.062a1.75 1.75 0 0 1-.46-1.657l.548-2.19a.68.68 0 0 0-.122-.58z"/></svg>`;
---
<nav class="nav">
  <div class="container nav__inner">
    <a href="/" class="nav__logo nav__logo--img">
      <img src="images/Logo-480.webp" alt={WERNEX.legalName} class="nav__logo-img" width="189" height="126" fetchpriority="high" decoding="async">
    </a>
    <div class="nav__links">
      {NAV_LINKS.map((l) => (
        <a href={l.href} class={active === l.href ? 'active' : undefined}>{l.label}</a>
      ))}
    </div>
    <a href={`tel:${WERNEX.phoneTel}`} class="nav__phone">
      <Fragment set:html={phoneSvg} />
      {WERNEX.phone}
    </a>
    <a href="/contact" class="btn btn--primary btn--sm nav__cta">Free Quote</a>
    {/* Google review badge: stars + text only, deliberately no rating number or count.
        Desktop: hangs below the bar as a small tab (the bar has no spare width).
        Mobile: sits inline between the logo and the hamburger. */}
    <a
      href={WERNEX.googleWriteReview}
      class="wx-greview"
      target="_blank"
      rel="noopener"
      aria-label="Leave a Google review (opens in a new tab)"
    >
      <span class="wx-greview__stars" aria-hidden="true"><i>★</i><i>★</i><i>★</i><i>★</i><i>★</i></span>
      <span class="wx-greview__text">Review us on Google</span>
    </a>
    <button class="nav__hamburger" aria-label="Toggle menu">
      <span></span><span></span><span></span>
    </button>
  </div>
  <div class="nav__mobile">
    {NAV_LINKS.map((l) => (
      <a href={l.href}>{l.label === 'Schedule Appt' ? 'Contact' : l.label}</a>
    ))}
    <a href={`tel:${WERNEX.phoneTel}`} class="mobile-phone">📞 {WERNEX.phone}</a>
  </div>
</nav>

<style>
  /* Google review badge — Astro scopes these rules to this component. */
  .nav__inner { position: relative; }

  .wx-greview {
    --wx-star: #FFB300; /* gold, from the same Material palette as --amber */
    position: absolute;
    top: 100%;
    right: 24px; /* lines up with the container padding / Free Quote button */
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 5px 14px 6px;
    background: rgba(13,40,24,0.92);
    border: 1px solid rgba(139,195,74,0.15);
    border-top: 0;
    border-radius: 0 0 var(--radius) var(--radius);
    box-shadow: 0 6px 16px rgba(0,0,0,0.18);
    color: rgba(255,255,255,0.85);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.78rem;
    line-height: 1.2;
    white-space: nowrap;
    transition: color var(--transition), padding var(--transition);
  }
  .wx-greview:hover,
  .wx-greview:focus-visible { color: var(--lime); padding-bottom: 8px; }
  .wx-greview:focus-visible { outline: 2px solid var(--lime-bright); outline-offset: 2px; }

  .wx-greview__stars {
    display: inline-flex;
    gap: 1px;
    color: var(--wx-star);
    font-size: 0.8rem;
    letter-spacing: 0;
  }
  .wx-greview__stars i {
    display: inline-block;
    font-style: normal;
  }

  /* Phone / tablet: the bar shows only logo + hamburger, so the badge fits inline. */
  @media (max-width: 960px) {
    .wx-greview {
      position: static;
      flex-direction: column;
      gap: 1px;
      padding: 4px 8px;
      margin: 0 8px;
      background: none;
      border: 0;
      border-radius: 8px;
      box-shadow: none;
      font-size: 0.72rem;
      text-align: center;
    }
    .wx-greview:hover,
    .wx-greview:focus-visible { padding-bottom: 4px; }
  }

  /* Stars flash left-to-right a few times on load (ends after ~4.3s), and
     once more on hover/focus. No motion at all for reduced-motion users. */
  @media (prefers-reduced-motion: no-preference) {
    .wx-greview__stars i {
      animation: wx-greview-chase 1.1s ease-in-out 0.6s 3 both;
    }
    .wx-greview:hover .wx-greview__stars i,
    .wx-greview:focus-visible .wx-greview__stars i {
      animation: wx-greview-chase-again 0.9s ease-in-out 0s 1 both;
    }
    .wx-greview__stars i:nth-child(2) { animation-delay: 0.7s; }
    .wx-greview__stars i:nth-child(3) { animation-delay: 0.8s; }
    .wx-greview__stars i:nth-child(4) { animation-delay: 0.9s; }
    .wx-greview__stars i:nth-child(5) { animation-delay: 1s; }
    .wx-greview:hover .wx-greview__stars i:nth-child(2),
    .wx-greview:focus-visible .wx-greview__stars i:nth-child(2) { animation-delay: 0.08s; }
    .wx-greview:hover .wx-greview__stars i:nth-child(3),
    .wx-greview:focus-visible .wx-greview__stars i:nth-child(3) { animation-delay: 0.16s; }
    .wx-greview:hover .wx-greview__stars i:nth-child(4),
    .wx-greview:focus-visible .wx-greview__stars i:nth-child(4) { animation-delay: 0.24s; }
    .wx-greview:hover .wx-greview__stars i:nth-child(5),
    .wx-greview:focus-visible .wx-greview__stars i:nth-child(5) { animation-delay: 0.32s; }
  }
  @keyframes wx-greview-chase {
    0%, 40%, 100% { transform: none; color: var(--wx-star); text-shadow: none; }
    15% { transform: scale(1.4) translateY(-1px); color: #FFE57F; text-shadow: 0 0 6px rgba(255,179,0,0.9); }
  }
  /* Same frames under a new name so hover restarts the animation. */
  @keyframes wx-greview-chase-again {
    0%, 40%, 100% { transform: none; color: var(--wx-star); text-shadow: none; }
    15% { transform: scale(1.4) translateY(-1px); color: #FFE57F; text-shadow: 0 0 6px rgba(255,179,0,0.9); }
  }
</style>
